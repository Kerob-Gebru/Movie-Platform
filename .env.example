# Copy to .env and set your private RapidAPI key. Never commit .env.
RAPIDAPI_KEY=replace_with_your_rapidapi_key
RAPIDAPI_HOST=netflix54.p.rapidapi.com
NETFLIX54_SEARCH_PATH=/search/
NETFLIX54_DETAILS_PATH=/title/details/
NETFLIX54_SEASONS_PATH=/title/seasons/
NETFLIX54_SIMILARS_PATH=/title/similars/
NETFLIX54_TRAILERS_PATH=/title/trailers/
NETFLIX54_EPISODES_PATH=/season/episodes/
NETFLIX54_LANGUAGES_PATH=/languages/
# Optional request protection (milliseconds). 503 responses are retried twice; 429
# responses are not retried automatically so the app does not worsen rate limits.
# These values are applied by the
# local Vite proxy; adjust only if your RapidAPI plan has a stricter rate limit.
NETFLIX54_MIN_REQUEST_INTERVAL_MS=1000
NETFLIX54_SEARCH_CACHE_TTL_MS=90000
NETFLIX54_DETAILS_CACHE_TTL_MS=300000
